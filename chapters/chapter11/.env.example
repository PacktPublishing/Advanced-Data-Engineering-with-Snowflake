# Identifiers only. Keep all real values in an untracked .env or secrets backend.
SNOWFLAKE_ACCOUNT=<organization-account>
SNOWFLAKE_USER=<service-user>

# This chapter standardizes on an UNENCRYPTED key file, the same file every
# tool loads. Dagster reads the key from a path; Prefect blocks read PEM content.
SNOWFLAKE_PRIVATE_KEY_PATH=<path-to-unencrypted-pem>
SNOWFLAKE_PRIVATE_KEY=<unencrypted-pem-from-secret-store>
SNOWFLAKE_ROLE=TRANSFORMER_RL
SNOWFLAKE_WAREHOUSE=BOOK_WH

# Only set these two if you use an encrypted key instead (the variant each
# tool's config notes). Leave them unset for the default unencrypted key.
# SNOWFLAKE_PRIVATE_KEY_PASSWORD=<private-key-passphrase>
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=<private-key-passphrase>  # Prefect's name

# Prefect deployment source must be immutable.
TECHFLOW_CODE_COMMIT_SHA=<40-character-git-commit-sha>

# Airflow local development expects the full connection JSON to be supplied
# outside source control. Never place private_key_content in this example file.
AIRFLOW_CONN_SNOWFLAKE_TECHFLOW=
# S3 connection JSON the deferrable S3KeySensor uses to wait for the scores file.
AIRFLOW_CONN_AWS_TECHFLOW=
