SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=TECHFLOW_ORCHESTRATOR
SNOWFLAKE_PRIVATE_KEY=replace_with_the_encrypted_pkcs8_private_key
SNOWFLAKE_PRIVATE_KEY_PASSWORD=replace_with_the_private_key_passphrase

DBT_SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/encrypted-private-key.p8
DBT_ENV_SECRET_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=replace_with_the_private_key_passphrase
