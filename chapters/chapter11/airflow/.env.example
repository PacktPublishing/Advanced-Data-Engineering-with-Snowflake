# Copy to airflow/.env for local use. The Chapter 11 .gitignore excludes .env.
AIRFLOW_UID=50000

# Placeholder only. Inject a real connection from a secrets backend in production.
# SnowflakePrivateKeyPemProfileMapping expects private_key_content; the provider
# accepts base64-encoded PKCS#8 PEM content.
AIRFLOW_CONN_SNOWFLAKE_TECHFLOW='{"conn_type":"snowflake","login":"replace_me","schema":"TRANSACTIONS","extra":{"account":"replace_me","database":"GOLD_DB","warehouse":"BOOK_WH","role":"TRANSFORMER_RL","private_key_content":"replace_me"}}'

# S3 connection the S3KeySensor uses to wait for the fraud-score file.
# Placeholder only. Inject real credentials from a secrets backend in production.
AIRFLOW_CONN_AWS_TECHFLOW='{"conn_type":"aws","extra":{"region_name":"us-east-1"}}'
